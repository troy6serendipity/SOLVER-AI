# 数据库配置
DATABASE_URL="postgresql://user:password@localhost:5432/solver_ai?schema=public"

# NextAuth 配置
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here (生成命令: openssl rand -hex 32)"

# 文件存储配置
STORAGE_ROOT=".storage"
STORAGE_URL_PREFIX="/api/storage"
STORAGE_SIGNATURE_SECRET="your-storage-secret-here"
STORAGE_SIGNED_URL_EXPIRY=3600

# LLM 服务配置（至少配置一个）
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# AI 网关配置
AI_RATE_LIMIT_REQUESTS_PER_MINUTE=30
AI_DAILY_QUOTA_TOKENS=100000

# 演示模式配置
DEMO_MODE_ENABLED=true
DEMO_USER_EMAIL="demo@solver-ai.com"
DEMO_USER_PASSWORD="demo123456"

# 环境配置
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SOLVER AI"