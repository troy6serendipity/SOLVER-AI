# ===== 数据库（PostgreSQL）=====
# 本地开发与 Vercel 生产共用同一套 Postgres 连接串即可。
# Neon：https://neon.tech 免费版即可，连接串需带 ?sslmode=require
# 示例：postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ===== Auth.js =====
# 生产环境务必替换：openssl rand -hex 32
AUTH_SECRET="please-replace-with-openssl-rand-hex-32"
AUTH_TRUST_HOST=true

# ===== AI 大模型（OpenAI 兼容协议）=====
# 留空 LLM_API_KEY 即自动启用本地 Mock 模型，无需密钥也能跑通全站功能
LLM_PROVIDER_ID="deepseek"
LLM_API_KEY=""
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_LIGHT_MODEL="deepseek-chat"
LLM_STRONG_MODEL="deepseek-reasoner"
LLM_MOCK="false"

# 通义千问（DashScope 兼容模式）参考配置：
# LLM_PROVIDER_ID="qwen"
# LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
# LLM_LIGHT_MODEL="qwen-turbo"
# LLM_STRONG_MODEL="qwen-max"
